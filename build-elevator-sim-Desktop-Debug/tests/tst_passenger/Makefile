dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

distdir: FORCE
	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents /usr/lib/x86_64-linux-gnu/qt5/mkspecs/features/data/dummy.cpp $(DISTDIR)/
	$(COPY_FILE) --parents ../../../elevator-sim/app/floor.h ../../../elevator-sim/app/elevatorcontrolsystem.h ../../../elevator-sim/app/elevator.h ../../../elevator-sim/app/passenger.h ../../../elevator-sim/app/upanddownpanel.h ../../../elevator-sim/app/elevatorpanel.h $(DISTDIR)/
	$(COPY_FILE) --parents ../../../elevator-sim/app/floor.cpp ../../../elevator-sim/app/elevatorcontrolsystem.cpp ../../../elevator-sim/app/elevator.cpp ../../../elevator-sim/app/passenger.cpp ../../../elevator-sim/app/upanddownpanel.cpp ../../../elevator-sim/app/door.cpp ../../../elevator-sim/app/elevatorpanel.cpp ../../../elevator-sim/tests/tst_passenger/tst_passenger.cpp $(DISTDIR)/


